msgid "companyHistory"
msgstr "تاريخ الشركة"

msgid "companyHistory_txt"
msgstr "<p>تأسست الشركة الأم في عام 1988 وبعد أن تحقق نجاح العمل وتعددت الأنشطة انبثقت عنها (أميال التميز) لتكون أكثر تخصصا. تهدف الشركة إلى تقديم مشاريع داخلية وخدمات تأثيث وفقا لمعايير ومستويات المنظور المحلي والعالمي المتميز من خلال خبرة مستشاريها. طوّرت أميال الامتياز بنية جديدة لتنظيم المناسبات والمؤتمرات مع أفضل الموارد البشرية والتقنيات والخدمات ، بناءً على خبرتها السابقة ، بالإضافة إلى البحث والتطوير الذي يقدم خدمات إضافية ، بدءاً بالتصميم والتنفيذ ، والمشاركة في التحليل والتسويق للفعاليات وتوفير الخدمات الصوتية  والبصرية و الضيافة</p>"

msgid "chairman_message"
msgstr "كلمة رئيس مجلس الأدارة"

msgid "chairman_message_txt"
msgstr " لقد عملنا دوما على تقديم أفضل الخدمات لعملاؤنا وتميزنا بقدرتنا على تطور ومواكبة الحداثة في النهضة العمرانية التي تشهدها المملكة ووسعنا نطاق أعمالنا لتغطي كافة أنحاء المملكة
كان ذلك بفضل الله ثم جهود الكادر الفني المتخصص لديكم حيث قدمتم كل ما يلزم للتوسع وتحقيق النجاح بتخصصكم في مجال الأعمال مدنية والإنشاءات الداخلية والديكور والتأثيث وتنظيم الفعاليات
وعليه يسعدني أن تكونو ضمن مجموعة العما بكيان مستقل متخصص بالأعمال المذكورة لتكون أميال التميز للفعاليات  خدمة جديدة لعملاءنا تواكب تطور أعمالهم وتقدم أفضل ما يمكن لتحويل الخيال للواقع وتلبية حاجات العملاء
الصدق والأمانة عماد النجاح فيجب أن تحافظو عليهما لنبقى أهلا للثقة الت عهدناها من عملاءنا والمتابعة الحثيثة لطلبات العملاء والدقة في الغنجاز تجعلكم دوما على سلم النجاح
<br/>"

