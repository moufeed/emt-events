@model List<SectionDto>
@{
    ViewData["Title"] = Localizer["sections"];
    ViewData["UnitTestPageClass"] = "ut-sections-index";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);
}

<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3> @Localizer["sections"] <small></small></h3>
        </div>
        <div class="title_right">
            <a href="@Url.AdminUrl("Create" , "sections")"
               class="btn btn-blue btn-add-new ut-create-btn">@Localizer["new_section"]</a>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">

        @{

            ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { };

        }
        @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")


        <div class="x_panel p-x-0">

            <div class="x_content">
                <partial name="_Filters.cshtml" model="ViewBag.FilterModel" />
                <div class="table-responsive">
                    <table class="table table-middle table-striped sections-table" id="sectionsTable">
                        <thead>
                            <tr>
                                <th width="100" class="text-center">@Localizer["t_image"]</th>
                                <th>@Localizer["t_title"]</th>

                                <th>@Localizer["t_summary"]</th>

                                <th width="150">@Localizer["t_section_parent"]</th>

                                <th width="100" class="text-center">@Localizer["t_visibility"]</th>
                                <th width="175">@Localizer["t_actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count > 0)
                            {
                                @foreach (var item in Model)
                                {
                                    
                            <tr id="tr-@item.Id">
                                <td class="text-center">

                                    <div class="tabel-img-circle">
                                        @if (!string.IsNullOrEmpty(item.MainImage))
                                        {

                                            <img src="@item.MainImage" alt="" width="60" />
                                        }
                                        else
                                        {
                                            <img src="~/Admin/img/noimage.jpg" alt="" width="75" />
                                        }
                                    </div>

                                </td>
                                
                                <td style="min-width:150px">
                            
                                  <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="@Localizer["t_edit"]"
                                           href="@Url.AdminUrl("Edit" ,"sections",new { id = item.Id })" class="underline ser-title">
                                        @item.Title
                                  </a>
                                </td>


                                <td>
                                    <div class="s-summary">
                                        @{
                                            string text = "";
                                            if (!string.IsNullOrWhiteSpace(item.Summary))
                                            {
                                                text = Regex.Replace(item.Summary, "<.*?>", String.Empty);
                                            }
                                        }
                                        @Html.Raw(text)
                                    </div>
                                </td>
                                <td>
                                    @item.ParentName
                                </td>
                                <td class="text-center">

                                    @if (item.Locked)
                                    {
                                        <if include-if="item.Published">
                                            <span class="label label-success">
                                                <i class="fa fa-eye "></i>
                                                @Localizer["t_published"]
                                            </span>
                                        </if>
                                        <if exclude-if="item.Published">
                                            <span class="label label-danger">
                                                <i class="fa fa-eye-slash "></i>
                                                @Localizer["t_unpublished"]
                                            </span>
                                        </if>
                                    }
                                    else
                                    {


                                         <span 
                                            data-toggle="tooltip" 
                                            data-placement="@(activeLang == "ar" ? "right" : "left")"
                                            data-status="true"
                                            title="@Localizer["t_unpublish"] / @Localizer["t_publish"]">
                                            
                                            <input 
                                            class="tgl tgl-flat toggle__publish"
                                            data-url="@Url.AdminUrl("PublishAsync","sections" , new { id = item.Id})"
                                            id="@item.Id"  
                                            type="checkbox"
                                            @((item.Published) ? "<text> checked </text>" : "" )/>
                                            <label class="tgl-btn" for="@item.Id" ></label>
                                        </span>
                                        
                                        
                                    }
                                </td>
                                <td>
                                    <div>
                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="@Localizer["t_details"]"
                                           href="@Url.AdminUrl("Details","sections",new { id = item.Id })"
                                           class="btn btn-view btn-round ut-detail_btn"><i class="fa fa-info "></i></a>

                                        <a data-toggle="tooltip"
                                           data-placement="top"
                                           title="@Localizer["t_edit"]"
                                           href="@Url.AdminUrl("Edit" ,"sections",new { id = item.Id })"
                                           class="btn btn-edit btn-round ut-edit_btn"><i class="fa fa-edit "></i></a>

                                        @if (item.Locked)
                                        {
                                            <span data-toggle="tooltip"
                                                  data-placement="@(activeLang == "ar" ? "right" : "left")"
                                                  class="btn-locked btn-round"
                                                  title="@Localizer["locked_by_system"]"><i class="fa fa-lock"></i></span>
                                        }
                                        else
                                        {
                                            <a data-toggle="tooltip"
                                               data-placement="top"
                                               data-id="@item.Id"
                                               data-url="@Url.AdminUrl("DeleteAsync", "sections", new { id = item.Id })"
                                               title="@Localizer["t_remove"]"
                                               class="btn btn-remove btn-round delete-service ut-section-removebtn"><i class="fa fa-trash-o "></i></a>
                                        }


                                        <if include-if="item.Published">
                                             <a href="@Url.AdminUrl("s","posts",new{ Area = "Portal" ,slug=$"{@item.SlugHierarchy.Trim('/')}"}).Replace("%2F", "/")"   
                                                data-placement="@(activeLang == "ar" ? "right" : "left")"
                                                title="@Localizer["View_in_website"]"
                                                data-toggle="tooltip"
                                                class="btn btn-view  btn-round" target="_blank">
                                            <i class="fa fa-external-link"></i>
                                        </a>
                                        </if>
                                    </div>


                                </td>
                            </tr>

                                }
                            }
                             

                        <if include-if='Model.Count == 0'>
                                <tr>
                                    <td colspan="8" class="text-center">
                                        <p class="empty_row">
                                            <i class='fa fa fa-exclamation-circle'></i>
                                            @Localizer["no_data_table"]
                                        </p>
                                    </td>
                                </tr>
                            </if>
                        </tbody>
                    </table>
                </div>
                
                  <hr class="m-y-2" />
                    <pagination controller-name="sections" filter-model="ViewBag.FilterModel" pagniation-model="ViewBag.pagination" total="true"></pagination>
                
            </div>
        </div>
    </div>
</div>

 
@section Styles{
    <link href="~/Admin/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
}


@section Scripts {
    <script src="~/Admin/js/sections.min.js"></script>
    <script src="~/Admin/lib/select2/dist/js/select2.js"></script>
    <script>
        $('.select_no-search').select2({ minimumResultsForSearch: -1});
        $('.select_picker').select2();
    </script>
}