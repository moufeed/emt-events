@{
    string _lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<footer class="page_footer ds  main-footer">
    <div class="ds py-5">
        <div class="container">
            <div class="row justify-content-between align-items-center">
                <div class="col-12 col-md-auto">
                    <div>
                        <img src="~/Portal/img/@(_lang == "ar" ? "main_logo_ar.png" : "main_logo.png" )" alt="" width="250">
                    </div>
                </div>
                <div class="col-12 col-md-auto">
                    <ul class="list-unstyled text-light">
                        <li><i class="fa fa-envelope-o mx-2"></i><a href="mailto:info@emt-events.co">info@emt-events.com</a> </li>
                        <li><i class="fa fa-phone mx-2"></i><span class="number" dir="ltr">@Localizer["telephone_number"]</span></li>
                        <li><i class="fa fa-fax mx-2"></i><span class="number" dir="ltr">@Localizer["fax_number"]</span></li>
                        <li><i class="fa fa-mobile mx-2"></i><span class="number" dir="ltr">@Localizer["mobile_number"]</span></li>
                    </ul>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="widget widget_social_buttons">

                        <if include-if="@(!string.IsNullOrEmpty(Localizer["facebook_link"].Value)
                            && Localizer["facebook_link"].Name != @Localizer["facebook_link"].Value)">
                            <a href="@Localizer["facebook_link"]" class="fa fa-facebook color-icon" title="facebook" target="_blank"></a>
                        </if>

                        <if include-if="@(!string.IsNullOrEmpty(Localizer["twitter_link"].Value)
                            && Localizer["twitter_link"].Name != @Localizer["twitter_link"].Value)">
                            <a href="@Localizer["twitter_link"]" class="fa fa-twitter color-icon" title="twitter" target="_blank"></a>
                        </if>

                        <if include-if="@(!string.IsNullOrEmpty(Localizer["google_link"].Value)
                            && Localizer["google_link"].Name != @Localizer["google_link"].Value)">
                            <a href="@Localizer["google_link"]" class="fa fa-google color-icon" title="google" target="_blank"></a>
                        </if>
                        <if include-if="@(!string.IsNullOrEmpty(Localizer["youtube_link"].Value)
                            && Localizer["youtube_link"].Name != @Localizer["youtube_link"].Value)">
                            <a href="@Localizer["youtube_link"]" class="fa fa-youtube-play color-icon" title="youtube" target="_blank"></a>
                        </if>

                        <if include-if="@(!string.IsNullOrEmpty(Localizer["linkedin_link"].Value)
                            && Localizer["linkedin_link"].Name != @Localizer["linkedin_link"].Value)">
                            <a href="@Localizer["linkedin_link"]" class="fa fa-linkedin color-icon" title="linkedin" target="_blank"></a>
                        </if>
                       
                        <if include-if="@(!string.IsNullOrEmpty(Localizer["instagram_link"].Value)
                            && Localizer["instagram_link"].Name != @Localizer["instagram_link"].Value)">
                            <a href="@Localizer["instagram_link"]" class="fa fa-instagram color-icon" title="instagram" target="_blank"></a>
                        </if>

                         <if include-if="@(!string.IsNullOrEmpty(Localizer["snapchat_link"].Value)
                            && Localizer["snapchat_link"].Name != @Localizer["snapchat_link"].Value)">
                            <a href="@Localizer["snapchat_link"]" class="fa fa-snapchat color-icon" title="snapchat" target="_blank"></a>
                        </if>
                       
                        
                       
                    </div>
                </div>
            </div>
        </div>
    </div>

</footer>


<section class="page_copyright light-copy cs s-py-20 s-py-lg-5 copyright">
    <div class="container">
        <div class="row align-items-center justify-content-between">

            <div class="col-12  col-sm-auto text-left">
                <p class="animate" data-animation="fadeInDown">
                    @Localizer["copyright_excellence_miles_All_rights_reserved", DateTime.Now.Year ]
                </p>
            </div>
            <div class="col-12  col-sm-auto">
                <p class="animate" data-animation="fadeInDown">@Localizer["Powered_by"] <a href="https://tamtech.solutions/" target="_blank">@Localizer["tamtech"]</a></p>
            </div>

        </div>
    </div>
</section>


	