 <section class="page-header " style="background-image :url('@ViewData["ImageURl"]');">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <h1 data-content="@ViewData["pageTitle"]" class="animate faster" data-animation="fastFromLeft">

            <strong>
                <span class="animate delay-5ms faster" data-animation="fastInUp">
                    <img src="~/Portal/img/logo.png" alt="Alternate Text" />
                </span>
                @ViewData["pageTitle"]
            </strong>
            </h1>
        </div>
    </div>
    <div class="flexslider-bottom d-none d-xl-block"> </div>
</section>