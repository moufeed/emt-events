@model PostDto
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content(Localizer["PostsImage"].Value);
    ViewData["pageTitle"] = Localizer["p_calendar"];

    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "Edit";

    bool HasSection = false;// ViewBag.Sections != null && ViewBag.Sections.Count > 0;
}
@using System.Text;
@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData);

@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />

    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}



<section class="ls s-py-50 s-pt-lg-50 s-pb-lg-100 c-gutter-60 post1">
    <div class="container">

        <div class="row justify-content-center">
            <main class="@(HasSection ? "col-md-8 col-lg-9" : "col-lg-10" )">
                <article class="post_item">
                    <h2 class="mt-3 mb-5 item-title animate fast" data-animation="fastInUp">
                        @Model.Title
                    </h2>
                    <div class="item-media post-thumbnail animate" data-animation="fadeIn">
                        @if (string.IsNullOrEmpty(Model.MainImage))
                        {

                            <img src="~/Portal/img/empty.jpg" class="empty-image" alt="@Model.Title" />
                        }
                        else
                        {
                            <img src="@Model.MainImage" alt="@Model.Title" />
                        }
                    </div>
                    <header class="animate" data-animation="fadeIn">

                        <div class="entry-meta icons link-a small-text border-top">
                             @if (Model.PostDate != null){
                            <i class="fa fa-calendar color-main fs-14"></i>
                            <span  class="url fn n"> @(string.Format("{0:yyyy/MM/dd}", Model.PostDate))</span>
                        }
                           
                             
                            <i class="fa fa-folder color-main fs-14"></i>
                            <a href="@Url.AdminUrl("s","posts",new{slug=$"{@Model.SectionSlug.Trim('/')}"}).Replace("%2F", "/")" class="url fn n">@Model.Section</a>

                            @if(Model.ViewsCount != null){
                                    <i class="fa fa-eye color-main"></i>
                                    <span class="url fn n"> @Model.ViewsCount</span>
                            }

                        </div>
                    </header>

                    <div class="item-content blog-post1">
                        <div class="entry-content">
                            @Html.Raw(Model.Content)
                        </div>
                    </div>

                </article>
                <div class="share-box mt-4">
                    <h6 class="mb-3">@Localizer["share_this"]</h6>

                    <!-- AddThis Button BEGIN -->
                    <div class="addthis_toolbox addthis_default_style ">
                        <a class="addthis_button_facebook_like" fb:like:layout="button_count"></a>
                        <a class="addthis_button_tweet"></a>
                        <a class="addthis_counter addthis_pill_style"></a>
                    </div>
                    <script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=xa-50faf75173aadc53"></script>
                    <!-- AddThis Button END -->
                </div>
            </main>

            <if include-if="HasSection">
                <aside class="col-md-4 col-lg-3">
                    <div class="sections-list widget">
                        <sections-list sections="ViewBag.Sections"
                                       action-name="s"
                                       controller-name="Posts"></sections-list>
                    </div>
                </aside>
            </if>
        </div>
    </div>
</section>
