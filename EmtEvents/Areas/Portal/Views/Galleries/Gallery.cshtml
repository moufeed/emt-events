@model GalleryDto;
@using TamTechSDK.Common.Services.ContentService.Galleries.Enums
@{
    ViewData["Title"] = Localizer["our_works"];
    Layout = "_Layout";
    ViewData["ImageURl"] = string.IsNullOrEmpty(Model.MainImage) ? @Url.Content(Localizer["GalleriesImage"].Value) : Model.MainImage;
    ViewData["pageTitle"] = ViewData["Title"];



}
@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml")
@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}
<if include-if="Model != null && Model.Id != default(Guid)">
    <section class="section-gallery">
        <div class="container photoswipe-container">
            <div class="row">
                <header class="col-lg-12 text-center mt-5">
                    <h3 class="color-main">
                        <span>@Model.Title</span>
                    </h3>
                    <p>
                        @Html.Raw(Model.Summary)
                    </p>
                    <div class="d-none d-lg-block divider-50"></div>
                </header>

                @if (Model.Items != null && Model.Items.Count > 0)
                {
                    foreach (GalleryItemDto item in Model.Items)
                    {


                        @if (item.GalleryItemType == (int)GalleryItemTypeEnum.YoutubeVideo)
                        {

                            <div class="col-xl-4 col-sm-6 item-gallery my-3">
                                <div class="d-flex jusify-content-center align-items-center">
                                    @if (string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <a href="https://img.youtube.com/vi/@item.VideoUrl/0.jpg" class="photoswipe-link"
                                           data-iframe="https://www.youtube.com/embed/@item.VideoUrl">
                                            <span>
                                                @Html.Raw(item.Summary)
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@item.MainImage" class="photoswipe-link" data-iframe="https://www.youtube.com/embed/@item.VideoUrl">
                                            <span>
                                                @Html.Raw(item.Summary)
                                            </span>
                                        </a>
                                    }
                                    @if (string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <img src="https://img.youtube.com/vi/@item.VideoUrl/0.jpg" alt="@item.Title">
                                    }
                                    else
                                    {
                                        <img src="@item.MainImage" alt="@item.Title">
                                    }
                                    <div class="content">
                                        <span class="item-type">
                                            <i class="fa fa-play" aria-hidden="true"></i>
                                            @Localizer["P_Video"]
                                        </span>
                                        <h6>@item.Title</h6>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-xl-4 col-sm-6 item-gallery my-3 animate" data-animation="fadeIn">
                                <div class="d-flex jusify-content-center align-items-center">
                                    @if (string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <a href="~/Portal/img/empty.jpg" class="photoswipe-link">
                                            <span>
                                                @Html.Raw(item.Summary)
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@item.MainImage" class="photoswipe-link">
                                            <span>
                                                @Html.Raw(item.Summary)
                                            </span>
                                        </a>
                                    }

                                    @if (string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <img src="~/Portal/img/empty.jpg" alt="@item.Title">
                                    }
                                    else
                                    {
                                        <img src="@item.MainImage" alt="@item.Title">
                                    }
                                    <div class="content">
                                        <span class="item-type">
                                            <i class="fa fa-picture-o" aria-hidden="true"></i>
                                            @Localizer["p_photo"]
                                        </span>
                                        <h6>
                                            @item.Title
                                        </h6>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
        <div class="d-none d-lg-block divider-50"></div>
    </section>
</if>

 



@section footer {
    <script src="~/Portal/js/gallery.min.js"></script>
  
}
