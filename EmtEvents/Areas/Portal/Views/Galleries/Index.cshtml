@model GalleryList;
@{
    ViewData["Title"] = Localizer["our_works"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content(Localizer["GalleriesImage"].Value);
    ViewData["pageTitle"] = Localizer["our_works"];
   
}

 

<partial name="~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml" />


<section class="galleries">
    <div class="container">
        <header class="text-center my-5">
            <p class="lead">
                @Localizer["galleries_message"]
            </p>
        </header>
        @if (Model.Data.Count > 0)
                    {
                        int index = 0;
                        foreach (GalleryLiteDto item in Model.Data)
                        {
                <article class="row work-item c-mb-30 c-mb-xl-60 c-gutter-60 @(index % 2 > 0 ? "flex-row-reverse" :"" )">
                    <div class="col-xl-8 ">
                        <div class="item-media animate fast d-flex justify-content-center align-items-center" data-animation="@(index % 2 > 0 ? "fastFromBottomRight" :"fastFromBottomLeft" ) ">
                            @if (string.IsNullOrEmpty(item.MainImage))
                            {
                               <img src="~/Portal/img/no-image.svg" alt="@item.Title" />
                            }
                            else
                            {
                                <img src="@item.MainImage" alt="@item.Title" />
                            }
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="item-content">
                            <h6 class="animate delay-2ms" data-animation="fadeIn">
                                <a href="@Url.PortalAction("v", "galleries", new { slug = item.Slug })">@item.Title</a>
                            </h6>
                            <div class="small-text animate delay-2ms" data-animation="fadeIn">
                                <span>@(string.Format("{0:dd/MM/yyyy}",item.CustomDate) ) </span>
                            </div>
                            <div class="small-text animate delay-2ms" data-animation="fadeIn">
                                <span>@item.Section</span>
                            </div>

                            <p class=" animate delay-4ms fast" data-animation="fadeIn">
                                 
                                @Html.Raw(item.Summary)
                            </p>
                            <div class="animate fast mt-4" data-animation="fadeIn">
                                <a href="@Url.PortalAction("v", "galleries", new { slug = item.Slug })" class="btn-link-more">@Localizer["Know_More"]</a>
                            </div>
                        </div>
                    </div>
                </article>
                                            index++;
                                        }
                                    }


                <div class="row">
                     <div class="col mb-5">
                         <partial name="_pagination" model="Model" />
                     </div>
                </div>
    </div>
</section>
