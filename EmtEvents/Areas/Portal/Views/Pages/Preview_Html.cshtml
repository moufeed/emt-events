@model PageDto



@{
    ViewData["Title"] =  String.IsNullOrEmpty(Model.Title) ? @Localizer["excellence_miles"].Value: Model.Title;
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content((string.IsNullOrEmpty(Model.MainImage) ? @Localizer["PagesImage"].Value : Model.MainImage ));
    ViewData["pageTitle"] = @Model.Title;

    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "EditHtmlPage";
     
}

@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)


@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <meta name="keywords" content="@(String.Join(',', Model.Keywords))">
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}

    

    
    <section class="section-page py-5">
        <div class="container">
            <div class="row">
                <div class="col ">
                    @Html.Raw(Model.HtmlContent)
                </div>
            </div>
        </div>
    </section>
 
