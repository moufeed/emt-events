@model PageDto
@{
    ViewData["Title"] = String.IsNullOrEmpty(Model.Title) ? @Localizer["excellence_miles"].Value : Model.Title;
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content((string.IsNullOrEmpty(Model.MainImage) ? @Localizer["PagesImage"].Value : Model.MainImage));
    ViewData["pageTitle"] = @Model.Title;

    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "EditSectionsPage";
}

@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)

@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
    <meta name="keywords" content="@(String.Join(',', Model.Keywords))">
}

    <section class="page-sections  ">
        <div class="container">
            <div class="row">
                @{int key = 0; int index = 0;}
                @if (Model.SectionsContent.Count > 3)
                {
                    <aside class="col-lg-3 d-none d-lg-block">

                        <div class="list-group list-group-flush list-keys">
                            @foreach (var content in Model.SectionsContent)
                            {
                                <a href="#content-@(key)" class="list-group-item list-group-item-action d-inline-block text-truncate">@content.Key</a>
                                key++;
                            }
                        </div>
                    </aside>
                }



                <div class="col">
                    <div id="accordion"   role="tablist">

                        @foreach (var content in Model.SectionsContent)
                        {
                            <div class="s_item" id="content-@(index)">
                                <div role="tab" id="collapse-@(index)_header">
                                    <h6>
                                        <a data-toggle="collapse" href="#collapse-@(index)" aria-expanded="true" aria-controls="collapse01">
                                            @content.Key
                                        </a>
                                    </h6>
                                </div>

                                <div id="collapse-@(index)" class="collapse show" role="tabpanel" aria-labelledby="collapse-@(index)_header" data-parent="#accordion">
                                    <div class="card-body">
                                        @Html.Raw(content.Value)
                                    </div>
                                </div>
                            </div>

                            index++;
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="divider-40 d-none d-xl-block"></div>
    </section>

 

 