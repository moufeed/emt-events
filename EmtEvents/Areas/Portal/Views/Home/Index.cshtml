
@{
    ViewData["Title"] = @Localizer["excellence_miles"];
    Layout = "_Layout";
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}



<partial name="partials/Index/_slider.cshtml" />
<partial name="partials/Index/_about.cshtml" />
<partial name="partials/Index/_services.cshtml" />
<partial name="partials/Index/_works.cshtml" />
<partial name="partials/Index/_events.cshtml" />
<partial name="partials/Index/_testimonials.cshtml" />
<partial name="partials/Index/_contactFooter.cshtml" />



@section SEO {
    <meta name="description" content="@Localizer["p_meta_description"]">
    <script type="application/ld+json">
        {
        "@@context": "http://schema.org",
        "@@type": "Organization",
        "url":  "@ViewBag.Host",
        "logo": "@ViewBag.Host/portal/img/seoLogo.jpg",
        "name": "@Localizer["excellence_miles"]",
        "telephone": "@Localizer["telephone_number"]"
        }
    </script>
}


@section footer{
    <script src="~/Portal/js/home.min.js"></script>
}
