
@using TamTechSDK.Common.Services.ContentService.Sliders.Models;
@{
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}


@if (ViewBag.publicMainSlider != null)
{
    SliderDto mainSlider = (SliderDto)ViewBag.publicMainSlider;

     

<if include-if="(mainSlider.Items != null && mainSlider.Items.Count > 0)">
    <section class="page_slider main_slider">
        <div class="flexslider" data-nav="true" data-dots="false" data-speed="3000">
            <ul class="slides">
                @{ int index = 1; }
                @foreach (var item in mainSlider.Items)
                {
                    string animation = "fadeInLeft";
                    string subanimation = "fastInDown";
                    switch (index)
                    {
                        case  1 :
                            animation = "bounceInLeft";
                            subanimation = "fastFromLeft";
                            break;
                        case 2:
                            animation = "bounceIn";
                            subanimation = "fastInDown";
                            break;
                        case 3:
                            animation = "bounceInLeft";
                            subanimation = "fastFromLeft";
                            break;

                        default:
                              animation = "fastFromLeft";
                              subanimation = "fastFromRight";
                            break;
                    }

                    <li class="ds text-center slide-@index">
                        <span class="flexslider-overlay"></span>
                        <img src="@item.MainImage" alt="">
                        <div class="container">
                            <div class="row">
                                <div class="col-12 itro_slider">
                                    <div class="intro_layers_wrapper">
                                        <div class="intro_layers">
                                            <div class="intro_layer animate fast" data-animation="@animation">
                                                <h2 class="text-uppercase intro_featured_word">
                                                    @item.Title
                                                </h2>
                                            </div>
                                            <div class="intro_layer animate" data-animation="@subanimation">
                                                <h3 class="intro_before_featured_word">
                                                    <span>@Html.Raw(item.Summary)</span>
                                                </h3>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                     
                        index++;
                     
                        }
            </ul>
        </div>
        <div class="flexslider-bottom d-none d-xl-block"></div>
    </section>
</if>
}

