<section class=" pb-60 ls text-section">

    <div class="container">
        <div class="row">
            <div class="text-center col-md-12 justify-content-center text-block">
                <div class="divider-35"></div>
                <div class="content">
                    <h1 class="animate fast" data-animation="fastInUp" >
                        @Localizer["Lets_get_started"]
                    </h1>
                    <p class="animate delay-2ms" data-animation="fastFromLeft" >
                        @Localizer["Lets_get_started_slogan"]
                    </p>
                    <div class="divider-30"></div>
                </div>
                <div>
                    @Localizer["fulladdress"]
                 </div>
                <div class="animate fast delay-2ms" data-animation="slideInUp" >
                    <div class="divider-40"></div>
                    <div class="btn-group btn-links">
                        <a href="@Url.Action("contactus","home")" class="btn btn-outline ">@Localizer["Lets_talk"]</a>
                        <a href="https://goo.gl/maps/RqRrtsPgR4u" class="btn btn-outline " target="_blank">@Localizer["Visit_us"]</a>
                    </div>
                    <div class="divider-30"></div>
                </div>
            </div>
        </div>
        <div class="divider-50"></div>
    </div>
</section>