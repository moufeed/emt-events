<section class=" pb-60 ls text-section">

    <div class="container">
        <div class="row">
            <div class="text-center col-md-12 justify-content-center text-block">
                <img src="./assets/img/vertical_line.png" alt="">
                <div class="divider-35"></div>
                <div class="content">
                    <h1 class="animate" data-animation="fadeInDown" data-appear-top-offset="250">
                        @Localizer["Lets_get_started"]
                         
                    </h1>
                    <p class="animate" data-animation="fadeIn" data-appear-top-offset="250">
                        @Localizer["Lets_get_started_slogan"]
                    </p>
                    <div class="divider-30"></div>
                </div>

                <div class="animate" data-animation="flipInX" data-appear-top-offset="250">
                    <div class="divider-40"></div>
                    <a href="@Url.Action("contactus","home")" class="btn btn-outline-maincolor">@Localizer["Lets_talk"]</a>
                    <div class="divider-30"></div>
                </div>

            </div>

        </div>
        <div class="divider-50"></div>
    </div>
</section>