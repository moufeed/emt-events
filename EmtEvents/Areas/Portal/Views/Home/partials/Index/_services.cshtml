@{ 
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);

}

<section class="s-pt-100 s-pt-lg-130 ds process-part skew_right s-parallax top_white_line_big overflow-visible" id="services">
    <div class="container">
        <div class="divider-35"></div>

        <div class="row">
            <div class="col-12 text-center mb-60">
                <h2 class="animate" data-animation="fadeInUp" data-appear-top-offset="250">@Localizer["latest_services"]</h2>
                <p class="animate" data-animation="fadeInDown" data-appear-top-offset="250">@Localizer["latest_services_slogan"]</p>
            </div>

            

            <div class="col-12 list-home-services">
                <if include-if="(ViewBag.services != null && ViewBag.services.Count > 0)">
                    @{ int index = 0; }

                    @foreach (ServiceDto item in ViewBag.services)
                    {

                    <div class="service-item ">
                        <h3 class="service-title">
                            <i class="fi @item.Icon animate" data-animation="@(((index % 2) == 0) ? "interInDownLeft" : "interInDownRight" ) " data-appear-top-offset="250"></i>
                            <strong class="animate" data-animation="fadeIn" data-appear-top-offset="250">@item.Title</strong>
                        </h3>
                        <p class="service-text animate" data-animation="fadeInUp">
                            @item.Summary
                        </p>
                    </div>

                        index++;
                    }
                </if>

                
  
 
            </div>
        </div>




        <div class="divider-10 d-block d-sm-none"></div>
        <div class="img-wrap text-center">
            <img src="~/Portal/img/vertical_line2.png" alt="">
        </div>

    </div>
</section>


