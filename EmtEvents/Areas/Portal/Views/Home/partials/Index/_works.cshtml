<section class="ls ms book-item ">

    <div class="corner corner-light"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8">
                <div class="text-block text-center">

                    <div class="img-wrap text-center">
                        <img src="~/Portal/img/vertical_line.png" alt="">
                        <div class="divider-35"></div>
                    </div>
                    <div>
                        <h5 class="animate fast" data-animation="fastFromLeft" >@Localizer["Latest_work"] </h5>
                        <p class="animate fast" data-animation="fastFromRight" >
                            @Localizer["Latest_work_slogan"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="divider-100"></div>
        <div class="row justify-content-center home-works">
            <div class="col-12 col-md-6 col-lg-5 witem">
                <div class="work-item animate" data-animation="fadeInLeft" >
                    <span class="w-image">
                        <a href="#">
                            <img src="~/Portal/img/projects/1.jpg" alt="">
                        </a>
                    </span>

                    <div>
                        <h6><a href="#">State Security part at the Janadriya Festival 2017	</a></h6>
                        <p>We presented an integrated study and worked hard to make this Event success</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-5 witem">
                <div class="work-item animate" data-animation="fadeInRight" >
                    <span class="w-image">
                        <a href="#">
                            <img src="~/Portal/img/projects/2.jpg" alt="">
                        </a>
                    </span>
                    <div>
                        <h6><a href="#"> Museum Of Science & Technology</a></h6>
                        <p>The museum was designed and implemented by the " Excellence  Miles "</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="divider-100"></div>

        <div class="img-wrap text-center">
            <img src="~/Portal/img/vertical_line.png" alt="">
        </div>
    </div>
</section>