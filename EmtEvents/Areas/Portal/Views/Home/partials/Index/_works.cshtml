



@{
    List<GalleryLiteDto> galleries = (List<GalleryLiteDto>)ViewBag.galleries;
}
   

<section class="ls ms book-item works ">

    <div class="corner corner-light"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8">
                <div class="text-block text-center">

                    <div class="img-wrap text-center">
                        <img src="~/Portal/img/vertical_line.png" alt="">
                        <div class="divider-35"></div>
                    </div>
                    <div>
                        <h5 class="animate fast" data-animation="fastFromLeft">@Localizer["Latest_work"] </h5>
                        <p class="animate fast" data-animation="fastFromRight">
                            @Localizer["Latest_work_slogan"]
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div class="divider-100"></div>
        <div class="row justify-content-center home-works">
            @if (ViewBag.galleries != null && galleries.Count > 0)
            {
                
                    int index = 0;
                
                @foreach (var gallery in galleries)
                {
                    <div class="col-12 col-md-6 col-lg-5 witem">
                        <div class="work-item animate" data-animation="@(index %2 == 0 ? "bounceInLeft" :"bounceInRight")">
                            <span class="w-image">
                                <a asp-action="v" asp-controller="galleries" asp-route-slug="@gallery.Slug">
                                    @if (string.IsNullOrEmpty(gallery.MainImage))
                                    {
                                    <img src="~/Portal/img/empty.jpg" alt="">
                                    }
                                    else
                                    {
                                        <img src="@gallery.MainImage" alt="">
                                    }

                                </a>
                            </span>
                           
                            <div>
                                  @if(gallery.CustomDate != null){
                                     <div>
                                    <small style="color:#b00">
                                        <i class="fa fa-calendar"></i>
                                         @(string.Format("{0:yyyy/MM/dd}", gallery.CustomDate))
                                    </small>
                                </div>
                                 <h6 style="margin-top:0;"><a asp-action="v" asp-controller="galleries" asp-route-slug="@gallery.Slug">@gallery.Title</a></h6>
                                }else{

                                <h6 ><a asp-action="v" asp-controller="galleries" asp-route-slug="@gallery.Slug">@gallery.Title</a></h6>
                                }
                                <p>
                                    @{
                                        string Summary = "";
                                        if (!string.IsNullOrWhiteSpace(gallery.Summary))
                                        {
                                            Summary = Regex.Replace(gallery.Summary, "<.*?>", String.Empty);
                                        }
                                    }
                                    @Html.Raw(Summary)
                                </p>
                            </div>
                        </div>
                    </div>
                    index++;
                }
            }

             
        </div>

        <div class="divider-100"></div>

        <div class="img-wrap text-center">
            <img src="~/Portal/img/vertical_line.png" alt="">
        </div>
    </div>
</section>
