
<div class="divider-10 d-block d-sm-none"></div>

<section class="s-pt-30 s-pt-lg-50 s-pt-xl-25 ls about-home" id="about">
    <div class="divider-5 d-none d-xl-block"></div>
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
                <div class="main-content text-center">
                    <div class="img-wrap text-center">
                        <img src="~/Portal/img/vertical_line.png" alt="">
                        <div class="divider-35"></div>
                    </div>
                    <h5 class="animate" data-animation="fadeInDown">
                        <strong>@Localizer["about_company"] </strong>
                    </h5>
                    @if (ViewBag.aboutSummary != null)
                    {
                        <p class="animate" data-animation="fadeInUp">
                            @Html.Raw(ViewBag.aboutSummary.Summary)
                        </p>
                    }
                    <div class="divider-100"></div>
                    <div class="img-wrap text-center">
                        <img src="~/Portal/img/vertical_line.png" alt="">
                    </div>



                </div>
            </div>
        </div>
    </div>

</section>
