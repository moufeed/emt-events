@model ServiceDto
@{


    ViewData["Title"] = Localizer["our_services"];
    Layout = "_Layout";
    ViewData["ImageURl"] = @Url.Content(string.IsNullOrEmpty(Model.MainImage) ? Localizer["ServicesImage"].Value  : Model.MainImage);
    ViewData["pageTitle"] = Localizer["our_services"];



    ViewBag.ItemId = Model.Id;
    ViewBag.Action = "edit";
}

@await Html.PartialAsync("~/Areas/Portal/Views/Shared/partials/_PageHeader.cshtml", @ViewData)

@section SEO{
    <meta name="description" content="@Html.Raw(Model.MetaDescription)" />
    <partial name="~/Areas/Portal/Views/Shared/partials/_SEO.cshtml" model="Model.SEOMarkup" />
}



    <section class="services-section py-5">
        <div class="divider-50 d-none d-md-block"></div>
            <div class="container">
                <header class="row align-items-center mb-4">
                    <if include-if="Model.IconVisibility">
                        <div class="col-md-3 text-center">
                            <i class="@(Model.Icon.Contains("fi")?"fi":"fa") @Model.Icon service-icon"></i>
                        </div>
                    </if>
                    <div class="@(Model.IconVisibility ?  "col-md-9" : "col-12" )">
                        <h2>@Model.Title</h2>

                        <div class="page-meta color-main">
                            @if (Model.CreatedDate != DateTime.MinValue)
                            {
                                <small class=""> <i class="fa fa-calendar"></i> @Model.CreatedDate.ToString("MMMM dd, yyyy") </small>
                            }
                            @if (!string.IsNullOrEmpty(Model.Section))
                            {
                                <small><i class="fa fa-folder-o" aria-hidden="true"></i>  @Model.Section </small>
                            }
                        </div>
                        <div class="suumary">
                            @Html.Raw(Model.Summary)
                        </div>
                    </div>
                </header>
                <div class="row">
                    <div class="col-12">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </div>
    </section>
 